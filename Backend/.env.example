# Copy to .env (gitignored) and fill in real values. Never commit .env.

# docker-compose postgres service bootstrap credentials (local dev only -
# this is the Postgres superuser, not the app's runtime role).
POSTGRES_USER=tanakh
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tanakh
POSTGRES_PORT=5432

# Read by the app/dotnet-ef exclusively via these two environment variables
# (see docs/database.md). Until db/roles/*.sql (D-12) has been run against
# this instance, both point at the bootstrap superuser above; afterwards,
# switch Username to app_user / migrations_user respectively.
ConnectionStrings__AppDb=Host=localhost;Port=5432;Database=tanakh;Username=tanakh;Password=changeme
ConnectionStrings__MigrationsDb=Host=localhost;Port=5432;Database=tanakh;Username=tanakh;Password=changeme
