# Copy to .env (gitignored) and fill in real values. Never commit .env.

# docker-compose postgres service bootstrap credentials (local dev only -
# this is the Postgres superuser, not the app's runtime role).
POSTGRES_USER=tanakh
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tanakh
POSTGRES_PORT=5432

# Read by the app/dotnet-ef exclusively via these two environment variables
# (see docs/database.md). Requires db/roles/migrations_user.sql and
# db/roles/app_user.sql to have been run once against this instance (as the
# POSTGRES_USER bootstrap superuser above) - run migrations_user.sql first,
# then app_user.sql, before the first `dotnet ef database update`.
ConnectionStrings__AppDb=Host=localhost;Port=5432;Database=tanakh;Username=app_user;Password=changeme
ConnectionStrings__MigrationsDb=Host=localhost;Port=5432;Database=tanakh;Username=migrations_user;Password=changeme
